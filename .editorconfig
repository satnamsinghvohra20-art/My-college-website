# http://editorconfig.org
# Top-most EditorConfig file for Smt. CHM College Web Platform & AI Suite
root = true

# ==============================================================================
# Global Default Settings for All Files
# ==============================================================================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ==============================================================================
# Web Frontend: HTML, CSS, JavaScript, JSON & SVG
# ==============================================================================
[*.{html,htm,css,scss,js,mjs,cjs,json,svg}]
indent_style = space
indent_size = 2
max_line_length = 120

# ==============================================================================
# Python Backend, ML Models & Automation Scripts (PEP 8 Compliance)
# ==============================================================================
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120
trim_trailing_whitespace = true

# ==============================================================================
# YAML Configuration Files
# ==============================================================================
[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# ==============================================================================
# Documentation & Markdown Files
# Note: Preserves 2 trailing spaces required for Markdown line breaks
# ==============================================================================
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# ==============================================================================
# Shell & OS-Specific Execution Scripts
# ==============================================================================
# Linux / Unix Shell Scripts (strictly LF for POSIX execution)
[*.sh]
end_of_line = lf
indent_size = 2

# Windows Batch & PowerShell Scripts (CRLF to prevent cmd.exe parsing errors)
[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 2

# ==============================================================================
# Minified & Bundled Assets (Do not reformat production bundles)
# ==============================================================================
[*.min.{js,css}]
indent_style = ignore
insert_final_newline = ignore
trim_trailing_whitespace = false
